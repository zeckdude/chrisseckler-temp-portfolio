# Environment variables required for the portfolio site

# --- Anthropic (required) ---
# Get your key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# --- Upstash Redis (required for rate limiting, usage tracking, conversation logs, presence) ---
# Create a free Redis database at https://console.upstash.com
# Copy the REST URL and token from the database dashboard.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token-here

# --- Upstash Vector (required for conversation RAG / ops chatbots) ---
# Create a Vector index at https://console.upstash.com (use a built-in embedding model,
# e.g. "text-embedding-3-small", so no separate embedding API is needed).
UPSTASH_VECTOR_REST_URL=https://your-vector-index.upstash.io
UPSTASH_VECTOR_REST_TOKEN=your-vector-token-here

# --- Ops dashboard (required for /ops pages) ---
# Any password you choose; set the same value in Vercel env vars for production.
ADMIN_PASSWORD=your-secret-password-here

# --- Vercel cron secret (auto-set by Vercel in production) ---
# Vercel injects this automatically. You only need to set it locally if you want
# to manually test the /api/ops/refresh-pricing cron endpoint.
# Generate with: openssl rand -hex 32
CRON_SECRET=your-cron-secret-here

# --- PostHog (optional — analytics & session replay) ---
# Write-only project key from PostHog → Project settings (safe in the browser).
NEXT_PUBLIC_POSTHOG_KEY=phc_...
# UI host for toolbar/dashboard links. Event ingest is proxied through /ingest.
NEXT_PUBLIC_POSTHOG_HOST=https://us.posthog.com
# Personal API key (server-only) for live /ops queries. PostHog → Settings → Personal API keys.
# Create with Read access on this project. Never prefix with NEXT_PUBLIC_.
POSTHOG_PERSONAL_API_KEY=phx_...
# Project id from PostHog project settings (this site: 566729).
POSTHOG_PROJECT_ID=566729

# ---------------------------------------------------------------
# WHAT GETS TRACKED IN REDIS
# ---------------------------------------------------------------
# Usage, conversations, and presence are env-prefixed (dev: or prod:) so local
# traffic never mixes into production stats. Pricing is global (shared).
#
# Usage:
#   <env>:chat:requests:total
#   <env>:chat:requests:daily:YYYY-MM-DD          — TTL 90 days
#   <env>:chat:tokens:total
#   <env>:chat:tokens:input:total
#   <env>:chat:tokens:output:total
#   <env>:chat:tokens:input:daily:YYYY-MM-DD      — TTL 90 days
#   <env>:chat:tokens:output:daily:YYYY-MM-DD     — TTL 90 days
#   <env>:chat:requests:hourly:YYYY-MM-DD:HH      — TTL 14 days
#   <env>:chat:tokens:hourly:YYYY-MM-DD:HH        — TTL 14 days
#   <env>:chat:tokens:max-context
#   <env>:chat:ip:<ip>:requests:total
#   <env>:chat:ip:<ip>:tokens:input:total
#   <env>:chat:ip:<ip>:tokens:output:total
#   <env>:chat:ip:leaderboard
#   <env>:chat:model:<slug>:requests:total
#   <env>:chat:model:<slug>:tokens:input:total
#   <env>:chat:model:<slug>:tokens:output:total
#   <env>:chat:models:seen
#
# Conversations:
#   <env>:conversations:<id>
#   <env>:conversations:index
#   <env>:conversations:total
#
# Presence (TTL ~35s on session keys):
#   <env>:presence:sessions
#   <env>:presence:session:<id>
#
# Pricing (global, not env-prefixed — Anthropic list rates):
#   pricing:<model>:input / pricing:<model>:output
#   pricing:fetchedAt / pricing:source
# Live rates are fetched weekly from OpenRouter; hardcoded fallbacks live in src/lib/ai-pricing.ts

